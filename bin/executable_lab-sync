#!/bin/sh
# lab-sync: run `lab sync` with GITLAB_TOKEN fetched from the keychain on demand.
# Token never persists: it's only in the environment of the `lab` child process.
set -eu

token=$(security find-generic-password -s 'glab:gitlab.pnet.ch:token' -w \
  | sed 's/^go-keyring-base64://' | base64 -d) || {
  echo "lab-sync: failed to read token from keychain" >&2
  exit 1
}
[ -n "$token" ] || { echo "lab-sync: empty token from keychain" >&2; exit 1; }

GITLAB_TOKEN="$token" exec lab sync "$@"
